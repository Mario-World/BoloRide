# Local demo secrets only. Replace with strong, unique values before deployment.
BUSINESS_API_KEY=local-demo-only-change-before-deploy

# Business API / PostgreSQL (the compose demo uses its own container DATABASE_URL).
DATABASE_URL=postgresql+asyncpg://bolo:replace-me@localhost:5432/bolo_ride
MOCK_PAYMENTS_ENABLED=true

# Set only if you later enable the Agora voice service.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
MURF_API_KEY=
